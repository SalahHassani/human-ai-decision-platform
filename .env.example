# PostgreSQL Connection
POSTGRES_DB=experiment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/experiment_db

# Frontend / Backend URLs
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Experiment Condition: condition_1 (3 Humans) | condition_2 (2 Humans + 1 AI) | condition_3 (1 Human + 2 AI)
EXPERIMENT_CONDITION=condition_2

# Admin / Demo Controls
ADMIN_TOKEN=dev-admin-token
DEMO_MODE=true

# Real LLM Configuration (set REAL_AI=true and supply API key(s); automatically falls back to rule_based on error/timeout/quota)
REAL_AI=true
AI_1_PROVIDER=gemini
AI_1_MODEL=gemini-flash-lite-latest
AI_1_API_KEY=your_api_key_here
AI_2_PROVIDER=gemini
AI_2_MODEL=gemini-flash-lite-latest
AI_2_API_KEY=your_api_key_here